# Large/sensitive data files: track locally, never commit.
# CSV / DB masters can be 100+ MB and contain article text.
# Class-weight .pt tensors are reproducible from src.data_prep.class_weights.
data/class_weights/*.pt
data/*.csv
data/*.db
data/*.relabel_ckpt
data/active_learning/
